# TEMPLATE, not a config. ${BACKEND_URL} is substituted by docker-entrypoint.sh
# at container start, and again at BUILD time with the Docker Compose default so
# the image still has a working /etc/nginx/conf.d/default.conf even if the
# entrypoint never runs.
#
# THIS IS THE ONLY COPY. The registry frontend keeps a second, near-identical
# nginx-ecs.conf.template beside its nginx.conf, and the two have already drifted
# apart (proxy_hide_header, client_max_body_size and the long-read timeout are in
# one and not the other). One templated file cannot drift from itself.
#
# ONLY ${BACKEND_URL} is substituted -- see the entrypoint's envsubst allowlist.
# Every other $name here is an nginx runtime variable ($csp_nonce, $request_id,
# $host, $remote_addr, $scheme, $uri, $proxy_add_x_forwarded_for) and must reach
# nginx untouched.

# Derive the per-request CSP nonce ONCE. A map variable is evaluated lazily and
# cached for the whole request, so the CSP header and the sub_filter body rewrite
# below see the SAME value. A plain `set $csp_nonce $request_id` inside the server
# block re-runs in the rewrite phase after the `try_files` internal redirect to
# /index.html and produces a SECOND, different id — the header nonce and the
# <meta>/emotion nonce then disagree and the browser blocks every injected style.
map $request_id $csp_nonce {
    default $request_id;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # ${BACKEND_URL} is https on Cloud Run / ACA — send SNI on proxied TLS.
    proxy_ssl_server_name on;

    # Security headers (mirrors the registry frontend). The CSP uses a per-request
    # nonce ($csp_nonce, from the map above): index.html ships a `__CSP_NONCE__`
    # placeholder that main.tsx feeds to emotion's cache, and sub_filter swaps it
    # for the same nonce so injected styles satisfy the policy. (In k8s the chart's
    # ConfigMap nginx applies the same block.)
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    # HSTS (#208). This block serves plain HTTP; TLS terminates at the ingress/ALB that
    # fronts this container (see the k8s chart and docker-compose). Browsers only honor
    # HSTS received over HTTPS, so this is effective when the fronting proxy passes it
    # through on the TLS response; if your proxy strips upstream headers, set the same
    # HSTS there instead. It is ignored (harmless) over plain HTTP, so it is safe to
    # emit here unconditionally, matching the registry frontend's posture.
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    # CSP (#210): base-uri and form-action do NOT fall back to default-src, so set them
    # explicitly to 'self'; object-src 'none' is explicit for clarity. img-src keeps
    # https: because the whitelabel/branding theme allows operator-supplied logo URLs.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'nonce-$csp_nonce'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none';" always;
    # Replace EVERY __CSP_NONCE__ (once off), not just the first: the placeholder
    # must reach the <meta> tag main.tsx reads even if another occurrence precedes
    # it in the document, otherwise emotion gets no nonce and styles are blocked.
    sub_filter_once off;
    sub_filter '__CSP_NONCE__' '$csp_nonce';

    # Whole .tfstate documents are posted as JSON request bodies (POST
    # /api/v1/analyze, PUT /api/v1/sources/{id}/state), and nginx's default cap is
    # 1 MiB. Every other nginx config in this product already sets 100m -- the
    # Helm ConfigMap, the kustomize base, the Cloud Run generator and the binary
    # bundle -- and this image was the lone outlier.
    client_max_body_size 100m;

    # Proxy API + probe endpoints to the backend service. The upstream is
    # ${BACKEND_URL}, which defaults to the Docker Compose service and is
    # overridden by the BACKEND_URL environment variable in any other deployment.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /health {
        proxy_pass ${BACKEND_URL};
    }

    location = /ready {
        proxy_pass ${BACKEND_URL};
    }

    # OpenAPI spec served by the backend (consumed by the API docs page).
    location ~ ^/swagger\.(json|yaml)$ {
        proxy_pass ${BACKEND_URL};
    }

    # SPA fallback: serve index.html for client-side routes.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
