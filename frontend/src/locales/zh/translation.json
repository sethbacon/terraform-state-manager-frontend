        }
      }
    },
    "oidcGroups": {
      "title": "OIDC 组",
      "overview": "Maps 将身份提供商的组声明映射到注册表中的组织和角色。当用户通过 OIDC 登录时，系统会从身份令牌中读取其组成员身份，并据此自动配置或更新其组织成员身份。更改将在下次登录时生效，无需重启服务器。",
      "actions": {
        "groupClaimName": {
          "heading": "团体索赔名称",
